        <mxCell id="layer1" value="Couche 1 : Ancrages Structuraux Positifs&#xa;(HasPositiveAnchor)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fontStyle=1;fillColor=#E3F2FD;strokeColor=#0277BD;size=0.05;" vertex="1" parent="1">
