<mxfile host="Electron" agent="Codex">
  <diagram id="etat_dossier" name="Diagramme d'États du Dossier">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#0f172a;fontFamily=Arial;whiteSpace=wrap;" value="Diagramme d'États — Cycle de Vie du Dossier de Souscription" vertex="1">
          <mxGeometry height="50" width="1700" x="50" y="20" as="geometry" />
        </mxCell>
        <!-- Initial state -->
        <mxCell id="init" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="100" y="200" as="geometry" />
        </mxCell>
        <!-- BROUILLON -->
        <mxCell id="brouillon" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;arcSize=12;fontSize=18;fontStyle=1;fontFamily=Arial;align=center;verticalAlign=middle;" value="BROUILLON" vertex="1">
          <mxGeometry height="70" width="220" x="200" y="180" as="geometry" />
        </mxCell>
        <!-- SOUMIS -->
        <mxCell id="soumis" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;arcSize=12;fontSize=18;fontStyle=1;fontFamily=Arial;align=center;verticalAlign=middle;" value="SOUMIS" vertex="1">
          <mxGeometry height="70" width="220" x="520" y="180" as="geometry" />
        </mxCell>
        <!-- EN_VERIFICATION -->
        <mxCell id="verification" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;strokeWidth=2;arcSize=12;fontSize=18;fontStyle=1;fontFamily=Arial;align=center;verticalAlign=middle;" value="EN_VÉRIFICATION" vertex="1">
          <mxGeometry height="70" width="220" x="840" y="180" as="geometry" />
        </mxCell>
        <!-- EN_ATTENTE -->
        <mxCell id="attente" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;arcSize=12;fontSize=18;fontStyle=1;fontFamily=Arial;align=center;verticalAlign=middle;" value="EN_ATTENTE" vertex="1">
          <mxGeometry height="70" width="220" x="1160" y="180" as="geometry" />
        </mxCell>
        <!-- VALIDÉ -->
        <mxCell id="valide" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;strokeWidth=3;arcSize=12;fontSize=18;fontStyle=1;fontColor=#1B5E20;fontFamily=Arial;align=center;verticalAlign=middle;" value="VALIDÉ ✓" vertex="1">
          <mxGeometry height="70" width="220" x="1000" y="400" as="geometry" />
        </mxCell>
        <!-- REJETÉ -->
        <mxCell id="rejete" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;strokeWidth=3;arcSize=12;fontSize=18;fontStyle=1;fontColor=#B71C1C;fontFamily=Arial;align=center;verticalAlign=middle;" value="REJETÉ ✗" vertex="1">
          <mxGeometry height="70" width="220" x="1320" y="400" as="geometry" />
        </mxCell>
        <!-- SYNCHRONISÉ -->
        <mxCell id="synchronise" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A237E;strokeColor=#0D1642;strokeWidth=2;arcSize=12;fontSize=18;fontStyle=1;fontColor=#FFFFFF;fontFamily=Arial;align=center;verticalAlign=middle;" value="SYNCHRONISÉ&lt;br&gt;(BADR)" vertex="1">
          <mxGeometry height="70" width="220" x="1000" y="580" as="geometry" />
        </mxCell>
        <!-- Final -->
        <mxCell id="final" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="1095" y="720" as="geometry" />
        </mxCell>
        <mxCell id="final_ring" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;aspect=fixed;" value="" vertex="1">
          <mxGeometry height="40" width="40" x="1090" y="715" as="geometry" />
        </mxCell>
        <!-- Transitions -->
        <mxCell id="t0" edge="1" parent="1" source="init" target="brouillon" style="rounded=1;strokeColor=#333;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontFamily=Arial;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t1" edge="1" parent="1" source="brouillon" target="soumis" style="rounded=1;strokeColor=#333;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontFamily=Arial;" value="soumettre()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t2" edge="1" parent="1" source="soumis" target="verification" style="rounded=1;strokeColor=#333;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontFamily=Arial;" value="lancer_pipeline()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t3" edge="1" parent="1" source="verification" target="attente" style="rounded=1;strokeColor=#333;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontFamily=Arial;" value="pipeline_terminé()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t4" edge="1" parent="1" source="attente" target="valide" style="rounded=1;strokeColor=#2E7D32;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontFamily=Arial;fontStyle=1;fontColor=#2E7D32;" value="approuver()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t5" edge="1" parent="1" source="attente" target="rejete" style="rounded=1;strokeColor=#C62828;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontFamily=Arial;fontStyle=1;fontColor=#C62828;" value="rejeter()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t6" edge="1" parent="1" source="valide" target="synchronise" style="rounded=1;strokeColor=#1A237E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontFamily=Arial;fontStyle=1;" value="sync_badr()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t7" edge="1" parent="1" source="rejete" target="brouillon" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#BF360C;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontFamily=Arial;fontStyle=1;fontColor=#BF360C;dashed=1;" value="corriger()">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1430" y="600" />
              <mxPoint x="310" y="600" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t8" edge="1" parent="1" source="synchronise" target="final_ring" style="rounded=1;strokeColor=#333;strokeWidth=2;endArrow=blockThin;endFill=1;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
