        </mxCell>
        <mxCell id="l1_desc" value="• Modèle J : REGISTRE ANALYTIQUE, INSCRIPTIONS PORTES&#xa;• Document IF : AAC140B, BULLETIN DE NOTIFICATION&#xa;• Taxe Prof : AAC060B, ATTESTATION D'INSCRIPTION&#xa;• ICE : CERTIFICAT DE L'IDENTIFIANT COMMUN DE L'ENTREPRISE&#xa;• CIN : Bande MRZ (&lt;&lt;) ou CARTE NATIONALE / CNIE" style="shape=rect;whiteSpace=wrap;html=1;align=left;fontSize=10;fillColor=#FFFFFF;strokeColor=#0277BD;" vertex="1" parent="1">
          <mxGeometry x="340" y="240" width="480" height="80" as="geometry" />
        </mxCell>

